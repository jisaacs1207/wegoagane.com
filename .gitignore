# wegoagane.com — keep secrets and machine noise out of Git.
# Tracked on purpose: docs/, .github/, handbook + CI (nothing here excludes those).

# --- Dependencies & builds (Node / Vite / tooling) ---
node_modules/
.pnp
.pnp.js
dist/
dist-ssr/
build/
out/
*.tsbuildinfo
.turbo/
.cache/
.parcel-cache/
.vite/

# --- Environment & secrets (never commit real keys) ---
.env
.env.*
!.env.example
!.env*.example
.dev.vars
wrangler.toml.local*

# --- Cloudflare Wrangler local state ---
.wrangler/
.mf/

# --- Logs & debug ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# --- OS & editor junk ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# --- Test / coverage ---
coverage/
.nyc_output/

# --- IDE (uncomment if you prefer not to commit editor settings) ---
# .idea/
# .vscode/

# --- Misc ---
*.local
.eslintcache
